{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sistema-chamados",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sistema-chamados-prod",
      "database_id": "e1df1007-d0f7-4919-80cc-4dbb56a72e82",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sistema-chamados-logos-prod"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
